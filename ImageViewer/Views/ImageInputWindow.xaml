<Window x:Class="ImageViewer.Views.ImageInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei" FontSize="12" Background="#F5F7F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <!-- 输入先保存在对话框，只有确定时才传给现有命令。 -->
        <StackPanel x:Name="scalePanel">
            <TextBlock Text="缩放比例" Margin="0,0,0,8" />
            <TextBox x:Name="scaleInput" AutomationProperties.Name="缩放比例" />
            <TextBlock Text="例如 100、150% 或 2x，超出范围会自动限制。"
                       Foreground="#61717E" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel x:Name="gammaPanel">
            <TextBlock Text="Gamma" Margin="0,0,0,8" />
            <TextBox x:Name="gammaInput" AutomationProperties.Name="Gamma" />
            <TextBlock Text="范围 0.05～20；小于 1 提亮，大于 1 压暗。"
                       Foreground="#61717E" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel x:Name="roiPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Margin="0,0,8,8" />
                <TextBox x:Name="roiXInput" Grid.Row="0" Grid.Column="1" Margin="0,0,16,8"
                         AutomationProperties.Name="ROI X" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" Margin="0,0,8,8" />
                <TextBox x:Name="roiYInput" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8"
                         AutomationProperties.Name="ROI Y" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="宽" Margin="0,0,8,0" />
                <TextBox x:Name="roiWidthInput" Grid.Row="1" Grid.Column="1" Margin="0,0,16,0"
                         AutomationProperties.Name="ROI 宽度" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="高" Margin="0,0,8,0" />
                <TextBox x:Name="roiHeightInput" Grid.Row="1" Grid.Column="3"
                         AutomationProperties.Name="ROI 高度" />
            </Grid>
            <TextBlock Text="X、Y 从 0 开始；宽高为正整数，超出图片的部分会裁切。"
                       Foreground="#61717E" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#A52A2A" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="确定" IsDefault="True" Click="OnApplyClick" />
            <Button Content="取消" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
