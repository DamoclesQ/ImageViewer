<Window x:Class="ImageViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:ImageViewer.Controls"
        Title="ImageViewer"
        Width="1100" Height="740" MinWidth="720" MinHeight="480"
        AllowDrop="True" FontFamily="Microsoft YaHei" FontSize="12"
        Background="#2F4F4F" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ImageViewer;component/Resources/ImageViewerIcon.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="MenuItem">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="#F0F0E8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
        <Style x:Key="StatusSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#70808A" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 菜单按操作分类，新增功能直接放入对应分类的 MenuItem。 -->
        <Border DockPanel.Dock="Top" Background="#E0E5E8">
            <StackPanel>
                <Menu x:Name="mainMenu" Background="Transparent" Padding="4,1">
                    <MenuItem Header="文件(_F)">
                        <MenuItem Header="打开图片(_O)..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                    </MenuItem>
                    <MenuItem Header="视图(_V)" IsEnabled="{Binding HasImage}">
                        <MenuItem Header="自动适配(_A)" Command="{Binding AutoFitCommand}" InputGestureText="Ctrl+0" />
                        <MenuItem Header="原始大小 1:1(_O)" Command="{Binding InitSizeCommand}" InputGestureText="Ctrl+1" />
                        <MenuItem Header="指定缩放比例(_S)..." Tag="Scale" IsEnabled="{Binding HasImage}" Click="OnEditImageInputClick" />
                        <Separator />
                        <MenuItem Header="平滑缩放(_M)" Command="{Binding ToggleSmoothScalingCommand}"
                                  IsCheckable="True" IsChecked="{Binding IsSmoothScaling, Mode=OneWay}" />
                    </MenuItem>
                    <MenuItem Header="显示(_D)" IsEnabled="{Binding HasImage}">
                        <MenuItem Header="调整 Gamma(_G)..." Tag="Gamma" IsEnabled="{Binding HasImage}" Click="OnEditImageInputClick" />
                        <MenuItem Header="重置 Gamma(_R)" Command="{Binding ResetGammaCommand}" />
                        <MenuItem Header="Jet 伪彩色(_J)" Command="{Binding TogglePseudoColorCommand}"
                                  IsEnabled="{Binding CanUsePseudoColor}"
                                  IsCheckable="True" IsChecked="{Binding IsPseudoColor, Mode=OneWay}" />
                        <Separator />
                        <MenuItem Header="中心十字线(_C)" Command="{Binding ToggleCrosshairCommand}" InputGestureText="C"
                                  IsCheckable="True" IsChecked="{Binding IsShowCrosshair, Mode=OneWay}" />
                        <MenuItem Header="像素文字背景(_B)" Command="{Binding ToggleTextBackCommand}"
                                  IsCheckable="True" IsChecked="{Binding IsUseTextBack, Mode=OneWay}" />
                        <MenuItem x:Name="overlayColorMenu" Header="叠加颜色(_L)" IsEnabled="{Binding HasImage}">
                            <MenuItem Header="红色(_R)" Tag="Red" IsCheckable="True" IsChecked="True" Click="OnOverlayColorClick">
                                <MenuItem.Icon>
                                    <Ellipse Width="12" Height="12" Fill="Red" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="绿色(_G)" Tag="Green" IsCheckable="True" Click="OnOverlayColorClick">
                                <MenuItem.Icon>
                                    <Ellipse Width="12" Height="12" Fill="Green" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="蓝色(_B)" Tag="Blue" IsCheckable="True" Click="OnOverlayColorClick">
                                <MenuItem.Icon>
                                    <Ellipse Width="12" Height="12" Fill="Blue" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="ROI(_R)" IsEnabled="{Binding HasImage}">
                        <MenuItem Header="框选工具(_S)" Command="{Binding ToggleRoiCommand}" InputGestureText="R"
                                  IsCheckable="True" IsChecked="{Binding IsSelectRoi, Mode=OneWay}" />
                        <MenuItem Header="手动设置(_M)..." Tag="Roi" IsEnabled="{Binding HasImage}" Click="OnEditImageInputClick" />
                        <MenuItem Header="清除 ROI(_C)" Command="{Binding ClearRoiCommand}" />
                        <Separator />
                        <MenuItem Header="清除选区和十字线(_A)" Command="{Binding EscapeCommand}" InputGestureText="Esc" />
                    </MenuItem>
                    <MenuItem Header="帮助(_H)">
                        <MenuItem Header="关于 ImageViewer(_A)..." Command="{Binding ShowAboutCommand}" />
                    </MenuItem>
                </Menu>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#A52A2A" Margin="8,4"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>


        <!-- 左侧显示查看状态，右侧显示当前图像信息，鼠标读数变化不移动右侧分组。 -->
        <Border DockPanel.Dock="Bottom" Background="#30383D" Height="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="45*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ScaleText}"
                               Style="{StaticResource StatusLabel}" ToolTip="缩放率" />
                    <Border Grid.Column="1" Style="{StaticResource StatusSeparator}" />
                    <TextBlock Grid.Column="2" Text="{Binding PixelLocationText}"
                               Style="{StaticResource StatusLabel}" ToolTip="原图像素坐标" />
                    <Border Grid.Column="3" Style="{StaticResource StatusSeparator}" />
                    <TextBlock Grid.Column="4" Text="{Binding PixelValueText}" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource StatusLabel}" ToolTip="{Binding PixelValueText}" />
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource StatusSeparator}" />
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ImageTypeText}"
                               Style="{StaticResource StatusLabel}" ToolTip="图像类型" />
                    <Border Grid.Column="1" Style="{StaticResource StatusSeparator}" />
                    <TextBlock Grid.Column="2" Text="{Binding ImageSizeText}"
                               Style="{StaticResource StatusLabel}" ToolTip="图像尺寸（宽 × 高）" />
                    <Border Grid.Column="3" Style="{StaticResource StatusSeparator}" />
                    <TextBlock Grid.Column="4" Text="{Binding ImgInfoText}" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource StatusLabel}" ToolTip="{Binding ImgPathToolTip}" />
                </Grid>
            </Grid>
        </Border>
        <Grid>
            <ctrl:ImageCanvasControl x:Name="imageCanvas" Focusable="True" />
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,5"
                    MaxWidth="600" CornerRadius="3" Background="#DD30383D" IsHitTestVisible="False"
                    Visibility="{Binding HasRoi, Converter={StaticResource BoolToVisibility}}">
                <TextBlock x:Name="roiSummary" Text="{Binding RoiInfoText}" FontFamily="Consolas"
                           Foreground="#C7E7F1" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
