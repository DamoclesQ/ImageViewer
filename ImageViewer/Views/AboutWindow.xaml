<Window x:Class="ImageViewer.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 ImageViewer"
        Width="450"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei"
        FontSize="12">
    <StackPanel Margin="24">
        <TextBlock Text="ImageViewer" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock x:Name="versionText" Margin="0,0,0,6" />
        <TextBlock Text="开发者：DamoclesQiu" />
        <Separator Margin="0,16" />
        <TextBlock Text="Git 仓库" Margin="0,0,0,6" />
        <TextBlock>
            <Hyperlink NavigateUri="https://github.com/DamoclesQ/ImageViewer"
                       RequestNavigate="OnRepositoryNavigate"
                       ToolTip="使用默认浏览器打开 GitHub 仓库">
                https://github.com/DamoclesQ/ImageViewer
            </Hyperlink>
        </TextBlock>
        <Button Content="关闭" Width="80" Padding="8,5" Margin="0,24,0,0"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
